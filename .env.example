# ─────────────────────────────────────────────
# Episode 1 — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Values below already match docker-compose.yml — no changes needed!
#   3. NEVER commit .env to GitHub (it has secrets!)
# ─────────────────────────────────────────────

# Django secret key — used for cryptographic signing
# Generate a real one at: https://djecrety.ir/
SECRET_KEY=your-super-secret-key-here

# Debug mode — True for development, False for production
DEBUG=True

# ─── PostgreSQL via Docker ─────────────────────
# These match the values in docker-compose.yml exactly
DB_NAME=taskmanager_db
DB_USER=taskmanager_user
DB_PASSWORD=taskmanager_pass
DB_HOST=localhost
DB_PORT=5432

# ─── CORS (for Episode 2 React frontend) ───────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
